{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/codex-portable-backup/package-2.0.schema.json",
  "title": "Codex Portable Backup Package 2.0",
  "type": "object",
  "required": [
    "formatId",
    "formatVersion",
    "generatorVersion",
    "backupComplete",
    "createdAtUtc",
    "source",
    "database",
    "counts",
    "hashManifest"
  ],
  "properties": {
    "formatId": { "const": "codex-portable-backup" },
    "formatVersion": { "const": "2.0" },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "backupComplete": { "const": true },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["computerName", "profilePath", "codexHome"],
      "properties": {
        "computerName": { "type": "string" },
        "profilePath": { "type": "string" },
        "codexHome": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "required": ["relativePath", "quickCheck", "schemaMigrationCount"],
      "properties": {
        "relativePath": { "const": "codex/state.snapshot.sqlite" },
        "quickCheck": { "const": "ok" },
        "schemaMigrationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "counts": {
      "type": "object",
      "required": ["threads", "sessionFiles", "projects", "hashedFiles"],
      "properties": {
        "threads": { "type": "integer", "minimum": 0 },
        "sessionFiles": { "type": "integer", "minimum": 0 },
        "projects": { "type": "integer", "minimum": 0 },
        "hashedFiles": { "type": "integer", "minimum": 0 },
        "attachmentsCopied": { "type": "integer", "minimum": 0 },
        "attachmentsMissing": { "type": "integer", "minimum": 0 }
      }
    },
    "hashManifest": {
      "type": "object",
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": { "const": "manifest/sha256.csv" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "additionalProperties": true
}
